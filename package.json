{
  "name": "parampara",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.3.0 <25"
  },
  "scripts": {
    "format": "turbo run //#format:check",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build"
  },
  "prettier": "@parampara/config/prettier",
  "devDependencies": {
    "@parampara/config": "workspace:*",
    "prettier": "3.9.10",
    "turbo": "2.11.7"
  }
}
