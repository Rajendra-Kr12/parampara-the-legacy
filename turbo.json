{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "globalPassThroughEnv": ["NEXT_TELEMETRY_DISABLED"],
  "tasks": {
    "//#format:check": {
      "inputs": ["$TURBO_DEFAULT$", "!.turbo/**", "!**/node_modules/**"]
    },
    "//#test:scripts": {
      "inputs": ["scripts/**", ".githooks/**"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/config/**"]
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/config/tsconfig.base.json"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/config/**"]
    },
    "@parampara/config#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/config/**",
        "$TURBO_ROOT$/.github/workflows/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/.gitignore"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/config/tsconfig.base.json"],
      "outputs": []
    }
  }
}
