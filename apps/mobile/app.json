{
  "expo": {
    "name": "Parampara",
    "slug": "parampara",
    "version": "0.0.0",
    "scheme": "parampara",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "dev.parampara.provisional",
      "supportsTablet": false
    },
    "android": {
      "package": "dev.parampara.provisional",
      "allowBackup": false
    },
    "plugins": ["expo-router", "expo-secure-store", ["@clerk/expo", { "appleSignIn": false }]],
    "experiments": {
      "typedRoutes": false
    }
  }
}
