# Copy to apps/mobile/.env.local and fill in values from the Clerk development instance
# and the Convex dev deployment. Never commit real keys.

# Public values, inlined into the app bundle by Expo. Both are public by design.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_CONVEX_URL=

# Never add CLERK_SECRET_KEY or a Convex deploy key here: the mobile app needs
# neither, and anything prefixed EXPO_PUBLIC_ ships inside the app.
