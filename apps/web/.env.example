# Copy to apps/web/.env.local and fill in values from the Clerk development instance
# and the Convex dev deployment. Never commit real keys.

# Public values, inlined into the browser bundle by Next.js.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CONVEX_URL=

# Server only. Never prefix with NEXT_PUBLIC_.
CLERK_SECRET_KEY=

# Optional: set to 1 to turn off Clerk SDK telemetry on the server as well
# (the browser side is already off in app/layout.tsx).
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=

# Playwright sign-in proof only: a synthetic Clerk test user (email and password,
# no real family data) and the display name users.me should return for it.
E2E_CLERK_USER_USERNAME=
E2E_CLERK_USER_PASSWORD=
E2E_CLERK_USER_NAME=
